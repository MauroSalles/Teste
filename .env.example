# =============================================================================
# GELATERIA CMD-WEB — VARIÁVEIS DE AMBIENTE
# =============================================================================
# Copie este arquivo como .env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais!
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gelateria
DB_USER=gelateria_user
DB_PASSWORD=sua_senha_segura_aqui

# URL completa (usada em produção pelo Render)
DATABASE_URL=postgresql://gelateria_user:sua_senha_segura_aqui@localhost:5432/gelateria

# -----------------------------------------------------------------------------
# BACKEND (Flask)
# -----------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=uma_chave_secreta_muito_longa_e_aleatoria_aqui
PORT=5000

# Origens permitidas para CORS (separadas por vírgula)
# Em desenvolvimento: http://localhost:3000,http://127.0.0.1:3000
# Em produção: https://gelateria.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
# URL da API do backend (sem barra no final)
# Em desenvolvimento: http://localhost:5000
# Em produção: https://gelateria-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# RENDER.COM (produção — preencher apenas no painel do Render)
# -----------------------------------------------------------------------------
# Estas variáveis são configuradas diretamente no painel do Render.com
# Não precisam estar neste arquivo, mas estão aqui para referência:
#
# RENDER_DB_EXTERNAL_URL=  (gerado automaticamente pelo Render)
# RENDER_SERVICE_NAME=gelateria-backend

# -----------------------------------------------------------------------------
# GITHUB ACTIONS / CI-CD
# -----------------------------------------------------------------------------
# Secrets configurados no GitHub (Settings > Secrets and variables > Actions):
#
# DATABASE_URL       → URL completa do PostgreSQL no Render
# RENDER_API_KEY     → API Key do Render (para deploy automático)
# RENDER_SERVICE_ID  → ID do serviço no Render
# VERCEL_TOKEN       → Token de autenticação do Vercel
# VERCEL_ORG_ID      → ID da organização no Vercel
# VERCEL_PROJECT_ID  → ID do projeto no Vercel

# -----------------------------------------------------------------------------
# MONITORAMENTO (opcional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx
# LOG_LEVEL=INFO
