# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# === FLASK ===
FLASK_ENV=development
PORT=5000
FLASK_SECRET_KEY=change-me-in-production

# === BANCO DE DADOS ===
DATABASE_URL=postgresql://user:pass@host:5432/gelateria
DB_HOST=localhost
DB_NAME=gelateria
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432
DB_POOL_MIN=1
DB_POOL_MAX=10

# === AUTENTICAÇÃO ===
JWT_SECRET_KEY=your-jwt-secret-here-use-long-random-string

# === CORS ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-frontend.vercel.app

# === STRIPE (Pagamentos com Cartão) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# === PIX / BRASPAG ===
BRASPAG_API_URL=https://apisandbox.braspag.com.br
BRASPAG_MERCHANT_ID=your-merchant-id
BRASPAG_API_KEY=your-api-key

# === INTELIGÊNCIA ARTIFICIAL (OpenAI) ===
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# === NOTIFICAÇÕES (SendGrid) ===
SENDGRID_API_KEY=SG....
FROM_EMAIL=noreply@suagelateria.com.br
FROM_NAME=Gelateria Pro

# === INSTAGRAM / WHATSAPP (Twilio) ===
INSTAGRAM_ACCESS_TOKEN=...
IG_BUSINESS_ACCOUNT_ID=...
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# === APP ===
APP_URL=https://sua-gelateria.onrender.com
