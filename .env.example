# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
PORT=5000

# Database connection pool
DB_POOL_MIN=1
DB_POOL_MAX=10

# Database (individual variables — used in local/Docker development)
DB_HOST=localhost
DB_NAME=gelateria
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432

# Database (single URL — used in Railway/Render production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis cache (optional — falls back to in-memory if not set)
# REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-frontend.vercel.app

