# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
PORT=5000

# Database connection pool
DB_POOL_MIN=1
DB_POOL_MAX=10

# Database (individual variables — used in local/Docker development)
DB_HOST=localhost
DB_NAME=gelateria
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432

# Database (single URL — used in Railway/Render production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-frontend.vercel.app

# Redis — caching layer (optional; app works without it using graceful fallback)
# Local Docker: redis://localhost:6379/0
# Render/Railway managed Redis: set the connection string provided by the platform
REDIS_URL=redis://localhost:6379/0

# Proxy / Frontend URLs — used by /infra/healthz for end-to-end checks
# Leave blank to skip those checks
PROXY_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
