# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
PORT=5000

# Database connection pool
DB_POOL_MIN=1
DB_POOL_MAX=10

# Database (individual variables — used in local/Docker development)
DB_HOST=localhost
DB_NAME=gelateria
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432

# Database (single URL — used in Railway/Render production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-frontend.vercel.app

# JWT
JWT_SECRET=change-me-in-production

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Braspag / Cielo (PIX)
BRASPAG_API_URL=https://api.braspag.com.br
BRASPAG_MERCHANT_ID=...
BRASPAG_API_KEY=...

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
