# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# All secrets MUST be changed before deploying to production.
# ──────────────────────────────────────────────────────────────────────────────

# === BANCO DE DADOS ===
# Single URL — used in Railway/Render production
DATABASE_URL=postgresql://user:pass@host:5432/gelateria

# Individual variables — used in local/Docker development
DB_HOST=localhost
DB_NAME=gelateria
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432

# Connection pool size
DB_POOL_MIN=1
DB_POOL_MAX=10

# === SEGURANÇA ===
JWT_SECRET_KEY=sua-chave-secreta-aqui
FLASK_SECRET_KEY=outra-chave-secreta

# === STRIPE (Pagamentos) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# === PIX (Braspag) ===
BRASPAG_API_URL=https://apisandbox.braspag.com.br
BRASPAG_MERCHANT_ID=...
BRASPAG_API_KEY=...

# === INTELIGÊNCIA ARTIFICIAL ===
OPENAI_API_KEY=sk-...

# === NOTIFICAÇÕES ===
SENDGRID_API_KEY=SG....
FROM_EMAIL=noreply@suagelateria.com.br

# === INSTAGRAM / WHATSAPP ===
INSTAGRAM_ACCESS_TOKEN=...
IG_BUSINESS_ACCOUNT_ID=...
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# === CORS ===
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-frontend.vercel.app

# === APP ===
APP_URL=https://sua-gelateria.onrender.com
FLASK_ENV=production
PORT=5000
