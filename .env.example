# Variáveis de Ambiente — copie este arquivo para .env e preencha os valores

# ────────────────────────────────────────────────
# Aplicação Flask
# ────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# ────────────────────────────────────────────────
# Banco de Dados (PostgreSQL)
# ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gelateria
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/gelateria

# ────────────────────────────────────────────────
# CORS — origens permitidas (separadas por vírgula)
# ────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ────────────────────────────────────────────────
# Produção (preencha antes do deploy)
# ────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://seu-projeto.vercel.app
# DATABASE_URL=postgresql://user:pass@host:5432/gelateria
