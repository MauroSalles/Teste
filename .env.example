# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
PORT=5000

# Database connection pool
DB_POOL_MIN=1
DB_POOL_MAX=10

# Database (individual variables — used in local/Docker development)
DB_HOST=localhost
DB_NAME=gelateria
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432

# Database (single URL — used in Railway/Render production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-frontend.vercel.app

# ── Tenant / White-label (spin-off config) ─────────────────────────────────────
TENANT_ID=gelateria_pro
TENANT_NAME=Gelateria Pro
TENANT_CURRENCY=BRL
TENANT_LOCALE=pt_BR
TENANT_TIMEZONE=America/Sao_Paulo
TENANT_LOGO_URL=
TENANT_PRIMARY_COLOR=#6C63FF

# ── Feature Flags (set to 1 to enable) ────────────────────────────────────────
FEATURE_MARKETPLACE=0
FEATURE_FRANCHISE_PORTAL=0
FEATURE_PUBLIC_API=0
FEATURE_I18N=1
FEATURE_AB_TEST=0
FEATURE_SPIN_OFF=0

# ── Public/Partner API keys (comma-separated) ─────────────────────────────────
# When FEATURE_PUBLIC_API=1, requests to /api/partners/* require X-API-Key header
PARTNER_API_KEYS=

# ── App metadata (used in OpenAPI spec) ────────────────────────────────────────
APP_VERSION=1.0.0
BASE_URL=http://localhost:5000

# ── Dynamic scaling (Docker Compose / Swarm) ──────────────────────────────────
BACKEND_REPLICAS=1
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=512M

# ── i18n default language ──────────────────────────────────────────────────────
# Supported: pt, en, es
DEFAULT_LANG=pt
