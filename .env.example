# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
PORT=5000
SECRET_KEY=your-secret-key-here
RELEASE_VERSION=1.0.0

# Database connection pool
DB_POOL_MIN=1
DB_POOL_MAX=10

# Database (individual variables — used in local/Docker development)
DB_HOST=localhost
DB_NAME=gelateria
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432

# Database (single URL — used in Railway/Render production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-frontend.vercel.app

# Error tracking (Sentry)
# SENTRY_DSN=https://...@sentry.io/...

# Deployment (CI/CD secrets — do NOT commit actual values)
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-...?key=...
# VERCEL_TOKEN=your-vercel-token
# VERCEL_ORG_ID=your-vercel-org-id
# VERCEL_PROJECT_ID=your-vercel-project-id
# SLACK_WEBHOOK=https://hooks.slack.com/services/...

# Monitoring (optional)
# UPTIME_ROBOT_API_KEY=your-key
# DATADOG_API_KEY=your-key

